<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- FolderBrowserDialog 등 WinForms 컴포넌트 사용 -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- ── 버전 ──────────────────────────────────────────────────────────
         배포할 때 이 값만 올리면 exe 파일명·속성·오류 로그가 모두 함께 바뀐다.
         (앱은 GetAppVersion() 으로 이 값을 읽어 오류 로그와 Excel 메타에 기록한다)

         올리는 기준
           1.x.x  결과가 달라지거나 사용법이 바뀔 때 (판정 기준 변경 등)
           x.1.x  기능 추가 (새 검사 항목·설비 타입 등), 기존 동작은 유지
           x.x.1  버그 수정만
    -->
    <Version>1.0.0</Version>
    <AssemblyName>MeasureHub.$(Version)</AssemblyName>

    <!-- exe 속성 창(마우스 오른쪽 > 속성 > 자세히)에 표시되는 정보.
         지정하지 않으면 AssemblyName 을 그대로 쓰기 때문에 회사명 자리에
         "MeasureHub.1.0.0" 같은 값이 들어간다. -->
    <Company>Jahwa Electronics</Company>
    <Product>MeasureHub</Product>
    <AssemblyTitle>MeasureHub - 측정 데이터 종합 정리·분석 도구</AssemblyTitle>
    <Description>측정 데이터 종합 정리·분석 도구</Description>
    <Copyright>Copyright (c) Jahwa Electronics</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\jahwa_header.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- tools\ 는 별도 콘솔 프로젝트(개발용 검증 도구)라 앱 빌드에 포함하지 않는다.
         SDK 프로젝트는 하위 폴더의 .cs 를 자동 포함하므로 명시적으로 제외해야 한다. -->
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- ScottPlot 5 WPF control for Bode plot rendering (log-x appearance via log-transformed data + custom ticks) -->
    <PackageReference Include="ScottPlot.WPF" Version="5.1.57" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>
</Project>
