<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- FolderBrowserDialog 등 WinForms 컴포넌트 사용 -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\jahwa_header.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- tools\ 는 별도 콘솔 프로젝트(개발용 검증 도구)라 앱 빌드에 포함하지 않는다.
         SDK 프로젝트는 하위 폴더의 .cs 를 자동 포함하므로 명시적으로 제외해야 한다. -->
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- ScottPlot 5 WPF control for Bode plot rendering (log-x appearance via log-transformed data + custom ticks) -->
    <PackageReference Include="ScottPlot.WPF" Version="5.1.57" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>
</Project>
