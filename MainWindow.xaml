<Window x:Class="JahwaInspector.Light.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JahwaInspector.Light.ViewModels"
        xmlns:views="clr-namespace:JahwaInspector.Light.Views"
        Title="Jahwa Inspector" Width="1500" Height="930"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Grid.Row="0" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Source="pack://application:,,,/Assets/jahwa_header.png"
                       Height="26" Stretch="Uniform" VerticalAlignment="Center"/>

                <Button Grid.Column="2" Style="{StaticResource ImportButton}" Content="Import"
                        Command="{Binding ImportCommand}" Width="120" FontWeight="Bold"/>

                <Button Grid.Column="4" Style="{StaticResource ExportButton}" Content="Export"
                        Command="{Binding ExportCommand}" Width="120"
                        IsEnabled="{Binding HasImportedFolder}" FontWeight="Bold"/>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ImportedFolderLabel}" Foreground="{StaticResource SubTextBrush}" Margin="0,0,12,0"/>
                    <ProgressBar Width="160" Height="8" Margin="0,0,10,0"
                                 Value="{Binding ProgressValue}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Cancel"
                            Command="{Binding CancelCommand}" Width="90"
                            IsEnabled="{Binding IsBusy}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="분석 설정" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="검사 항목" Foreground="{StaticResource SubTextBrush}" Margin="2,0,0,6"/>
                        <ComboBox ItemsSource="{Binding InspectionOptions}" SelectedItem="{Binding SelectedInspection}"/>

                        <StackPanel Visibility="{Binding IsFraInspection, Converter={StaticResource BoolToVis}}">
                            <Border Margin="0,14,0,0"
                                    Padding="12"
                                    Background="White"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="FRA 모드"
                                                       Foreground="{StaticResource SubTextBrush}"
                                                       FontSize="11"
                                                       Margin="2,0,0,5"/>
                                            <ComboBox ItemsSource="{Binding FraModeOptions}"
                                                      SelectedItem="{Binding SelectedFraMode}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Phase"
                                                       Foreground="{StaticResource SubTextBrush}"
                                                       FontSize="11"
                                                       Margin="2,0,0,5"/>
                                            <ComboBox ItemsSource="{Binding FraPhaseOptions}"
                                                      SelectedItem="{Binding SelectedFraPhaseOption}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Data Type"
                                               Foreground="{StaticResource SubTextBrush}"
                                               FontSize="11"
                                               Margin="2,11,0,5"/>
                                    <ComboBox ItemsSource="{Binding FraDataTypeOptions}"
                                              SelectedItem="{Binding SelectedFraDataType}"/>

                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,10"/>
                                    <TextBlock Text="CSV HEADERS"
                                               Foreground="{StaticResource SubTextBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Margin="2,0,0,7"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Frequency" Foreground="{StaticResource SubTextBrush}" FontSize="10" Margin="2,2,8,5"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FraFrequencyHeaders}" FontFamily="Cascadia Mono,Consolas" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,5"/>

                                        <TextBlock Grid.Row="1" Text="Gain" Foreground="{StaticResource SubTextBrush}" FontSize="10" Margin="2,2,8,5"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FraGainHeaders}" FontFamily="Cascadia Mono,Consolas" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,5"/>

                                        <TextBlock Grid.Row="2" Text="Phase" Foreground="{StaticResource SubTextBrush}" FontSize="10" Margin="2,2,8,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FraPhaseHeaders}" FontFamily="Cascadia Mono,Consolas" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </Grid>

                                    <TextBlock Text="Fallback  ·  Column 1 / 2 / 3"
                                               Foreground="{StaticResource SubTextBrush}"
                                               FontSize="10"
                                               Margin="2,9,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsSettlingInspection, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Data Type" Foreground="{StaticResource SubTextBrush}" Margin="2,14,0,6"/>
                            <ComboBox ItemsSource="{Binding SettlingVendorOptions}" SelectedItem="{Binding SelectedSettlingVendorOption}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="12" Margin="0,10,0,0" Background="{StaticResource PanelBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                            <ContentControl Content="{Binding ActiveSpec}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Right -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding ActiveTabTitle}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ActiveTabSubtitle}" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource SegmentButton}" Content="Plot" IsChecked="{Binding IsPlotTab}" Margin="0,0,6,0"/>
                            <ToggleButton Style="{StaticResource SegmentButton}" Content="Table" IsChecked="{Binding IsTableTab}" Margin="0,0,6,0"/>
                            <ToggleButton Style="{StaticResource SegmentButton}" Content="Raw" IsChecked="{Binding IsRawTab}"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PanelBrush}">
                        <Grid>
                            <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
                                    <TextBlock Text="Select a folder using Import, then process CSV files with Export."
                                               FontSize="16" FontWeight="SemiBold" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Grid Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolToVis}}">
                                <views:PlotView Visibility="{Binding IsPlotTab, Converter={StaticResource BoolToVis}}"/>

                                <DataGrid ItemsSource="{Binding FraResults}"
                                          SelectedItem="{Binding SelectedFraRow}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          Visibility="{Binding IsTableTab, Converter={StaticResource BoolToVis}}"
                                          Margin="12">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid">
                                            <Setter Property="Visibility" Value="{Binding IsTableTab, Converter={StaticResource BoolToVis}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFraInspection}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/>
                                        <DataGridTextColumn Header="Judge" Binding="{Binding Judge}" Width="*"/>
                                        <DataGridTextColumn Header="Reason" Binding="{Binding JudgeReason}" Width="2*"/>
                                        <DataGridTextColumn Header="10Hz Gain" Binding="{Binding Gain10Hz, StringFormat={}{0:F2}}" Width="*"/>
                                        <DataGridTextColumn Header="GM" Binding="{Binding GM, StringFormat={}{0:F2}}" Width="*"/>
                                        <DataGridTextColumn Header="PM" Binding="{Binding PM, StringFormat={}{0:F2}}" Width="*"/>
                                        <DataGridTextColumn Header="PM(-3dB)" Binding="{Binding PM3, StringFormat={}{0:F2}}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <DataGrid ItemsSource="{Binding DcResults}"
                                          SelectedItem="{Binding SelectedDcRow}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          Margin="12">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsTableTab}" Value="True"/>
                                                        <Condition Binding="{Binding IsDcSensitivityInspection}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/>
                                        <DataGridTextColumn Header="Header Row" Binding="{Binding HeaderRow}" Width="*"/>
                                        <DataGridTextColumn Header="Input Col" Binding="{Binding InputColumn}" Width="*"/>
                                        <DataGridTextColumn Header="Output Col" Binding="{Binding OutputColumn}" Width="*"/>
                                        <DataGridTextColumn Header="Up Count" Binding="{Binding UpCount}" Width="*"/>
                                        <DataGridTextColumn Header="Down Count" Binding="{Binding DownCount}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <DataGrid ItemsSource="{Binding ScanResults}"
                                          SelectedItem="{Binding SelectedScanRow}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          Margin="12">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsTableTab}" Value="True"/>
                                                        <Condition Binding="{Binding IsScanInspection}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/>
                                        <DataGridTextColumn Header="Judge" Binding="{Binding Judge}" Width="*"/>
                                        <DataGridTextColumn Header="Reason" Binding="{Binding JudgeReason}" Width="2*"/>
                                        <DataGridTextColumn Header="Range1" Binding="{Binding Range1}" Width="*"/>
                                        <DataGridTextColumn Header="Hys1" Binding="{Binding Hys1, StringFormat={}{0:F3}}" Width="*"/>
                                        <DataGridTextColumn Header="LI1" Binding="{Binding Li1, StringFormat={}{0:F3}}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <DataGrid ItemsSource="{Binding TiltResults}"
                                          SelectedItem="{Binding SelectedTiltRow}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          Margin="12">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsTableTab}" Value="True"/>
                                                        <Condition Binding="{Binding IsTiltInspection}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/>
                                        <DataGridTextColumn Header="Judge" Binding="{Binding Judge}" Width="*"/>
                                        <DataGridTextColumn Header="Reason" Binding="{Binding JudgeReason}" Width="2*"/>
                                        <DataGridTextColumn Header="Up Count" Binding="{Binding UpCount}" Width="*"/>
                                        <DataGridTextColumn Header="Down Count" Binding="{Binding DownCount}" Width="*"/>
                                        <DataGridTextColumn Header="Peak Up" Binding="{Binding PeakTiltUp, StringFormat={}{0:F3}}" Width="*"/>
                                        <DataGridTextColumn Header="Peak Down" Binding="{Binding PeakTiltDown, StringFormat={}{0:F3}}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <DataGrid ItemsSource="{Binding SinewaveResults}"
                                          SelectedItem="{Binding SelectedSinewaveRow}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          Margin="12">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsTableTab}" Value="True"/>
                                                        <Condition Binding="{Binding IsSinewaveInspection}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/>
                                        <DataGridTextColumn Header="Judge" Binding="{Binding Judge}" Width="*"/>
                                        <DataGridTextColumn Header="Reason" Binding="{Binding JudgeReason}" Width="2*"/>
                                        <DataGridTextColumn Header="Sample Count" Binding="{Binding SampleCount}" Width="*"/>
                                        <DataGridTextColumn Header="MaxErr X" Binding="{Binding MaxErrX, StringFormat={}{0:F3}}" Width="*"/>
                                        <DataGridTextColumn Header="MaxErr Y" Binding="{Binding MaxErrY, StringFormat={}{0:F3}}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <DataGrid ItemsSource="{Binding CircleResults}"
                                          SelectedItem="{Binding SelectedCircleRow}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          Margin="12">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsTableTab}" Value="True"/>
                                                        <Condition Binding="{Binding IsCircleInspection}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/>
                                        <DataGridTextColumn Header="Judge" Binding="{Binding Judge}" Width="*"/>
                                        <DataGridTextColumn Header="Reason" Binding="{Binding JudgeReason}" Width="2*"/>
                                        <DataGridTextColumn Header="Sample Count" Binding="{Binding SampleCount}" Width="*"/>
                                        <DataGridTextColumn Header="MaxErr X" Binding="{Binding MaxErrX, StringFormat={}{0:F3}}" Width="*"/>
                                        <DataGridTextColumn Header="MaxErr Y" Binding="{Binding MaxErrY, StringFormat={}{0:F3}}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <DataGrid ItemsSource="{Binding SquareResults}"
                                          SelectedItem="{Binding SelectedSquareRow}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          Margin="12">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsTableTab}" Value="True"/>
                                                        <Condition Binding="{Binding IsSquareInspection}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/>
                                        <DataGridTextColumn Header="Judge" Binding="{Binding Judge}" Width="*"/>
                                        <DataGridTextColumn Header="Reason" Binding="{Binding JudgeReason}" Width="2*"/>
                                        <DataGridTextColumn Header="Sample Count" Binding="{Binding SampleCount}" Width="*"/>
                                        <DataGridTextColumn Header="Settling (Max)" Binding="{Binding MaxSettlingMs, StringFormat={}{0:F3}}" Width="*"/>
                                        <DataGridTextColumn Header="Overshoot (Max)" Binding="{Binding MaxOvershoot, StringFormat={}{0:F3}}" Width="*"/>
                                        <DataGridTextColumn Header="Settling Up" Binding="{Binding MaxSettlingUpMs, StringFormat={}{0:F3}}" Width="*"/>
                                        <DataGridTextColumn Header="Overshoot Up" Binding="{Binding MaxOvershootUp, StringFormat={}{0:F3}}" Width="*"/>
                                        <DataGridTextColumn Header="Settling Down" Binding="{Binding MaxSettlingDownMs, StringFormat={}{0:F3}}" Width="*"/>
                                        <DataGridTextColumn Header="Overshoot Down" Binding="{Binding MaxOvershootDown, StringFormat={}{0:F3}}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <DataGrid ItemsSource="{Binding SettlingResults}"
                                          SelectedItem="{Binding SelectedSettlingRow}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          Margin="12">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsTableTab}" Value="True"/>
                                                        <Condition Binding="{Binding IsSettlingInspection}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/>
                                        <DataGridTextColumn Header="Group/Axis" Binding="{Binding GroupLabel}" Width="2*"/>
                                        <DataGridTextColumn Header="Judge" Binding="{Binding Judge}" Width="*"/>
                                        <DataGridTextColumn Header="Reason" Binding="{Binding JudgeReason}" Width="2*"/>
                                        <DataGridTextColumn Header="Target" Binding="{Binding Target, StringFormat={}{0:F2}}" Width="*"/>
                                        <DataGridTextColumn Header="Settling(ms)" Binding="{Binding SettlingTimeMs, StringFormat={}{0:F2}}" Width="*"/>
                                        <DataGridTextColumn Header="Overshoot" Binding="{Binding Overshoot, StringFormat={}{0:F2}}" Width="*"/>
                                        <DataGridTextColumn Header="Displacement" Binding="{Binding Displacement, StringFormat={}{0:F2}}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Visibility="{Binding IsRawTab, Converter={StaticResource BoolToVis}}" Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Raw 미리보기(상위 30행) - 전체 데이터는 Export 결과 CSV를 확인하세요."
                                               Foreground="{StaticResource SubTextBrush}"/>
                                    <DataGrid Grid.Row="2"
                                              ItemsSource="{Binding RawPreview}"
                                              AutoGenerateColumns="True"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

