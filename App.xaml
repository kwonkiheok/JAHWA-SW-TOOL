                        <DataGridTextColumn Header="조건" Binding="{Binding GroupLabel}" IsReadOnly="True" Width="2*"/>
                        <DataGridTextColumn Header="Tolerance(±)" Binding="{Binding ToleranceBand, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
