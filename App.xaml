                        <TextBlock Text="Tail Window (%)" Foreground="{StaticResource SubTextBrush}" Margin="2,0,0,6"/>
                        <TextBox Text="{Binding TailWindowPercent, UpdateSourceTrigger=PropertyChanged}"/>
