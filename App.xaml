<Application x:Class="MeasureHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MeasureHub.Converters"
             xmlns:vm="clr-namespace:MeasureHub.ViewModels"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <Color x:Key="BgColor">#F5F6F8</Color>
        <Color x:Key="CardColor">#FFFFFFFF</Color>
        <Color x:Key="PanelColor">#FFFFFFFF</Color>
        <Color x:Key="BorderColor">#E5E7EB</Color>
        <Color x:Key="TextColor">#111827</Color>
        <Color x:Key="SubTextColor">#6B7280</Color>
        <!-- Accent: brand-friendly green (Import/Export 공통) -->
        <!--<Color x:Key="AccentColor">#2E7D32</Color>-->
        <!--<Color x:Key="AccentColor">#F97316</Color>-->
        <!--<Color x:Key="AccentColor">#FB923C</Color>-->
        <Color x:Key="AccentColor">#22C55E</Color>
        <!-- Orange -->

        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="{StaticResource SubTextColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>

        <CornerRadius x:Key="CardRadius">12</CornerRadius>

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded ComboBox template (버튼/입력창과 동일한 톤) -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="10"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="6,0,0,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                                    <ToggleButton Grid.Column="1"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Cursor="Hand">
                                        <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border CornerRadius="10"
                                        Background="White"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="4">
                                    <ScrollViewer MaxHeight="260" SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="ImportButton" TargetType="Button">
            <Setter Property="Padding" Value="22,7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#0EA47A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0B8C67"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportButton" TargetType="Button">
            <Setter Property="Padding" Value="22,7"/>
            <Setter Property="Foreground" Value="#4DD4A8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#4DD4A8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4DD4A8"/>
                                <Setter Property="Foreground" Value="#0F1923"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GraphExtractButton" TargetType="Button">
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Foreground" Value="#1A1000"/>
            <Setter Property="Background" Value="#E8A825"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D49A1E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentButton" TargetType="ToggleButton">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <!-- 선택 상태도 흰 계열 유지 (과한 컬러 강조 제거) -->
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.12"/>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:FraSpecViewModel}">
            <StackPanel>
                <TextBlock Text="FRA Spec" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="GM / PM / PM(-3dB) Spec 기준을 설정합니다." Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Spec GM (dB)" Foreground="{StaticResource SubTextBrush}" Margin="2,0,0,6"/>
                        <TextBox Text="{Binding GainMarginDb, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Spec PM (deg)" Foreground="{StaticResource SubTextBrush}" Margin="2,0,0,6"/>
                        <TextBox Text="{Binding PhaseMarginDeg, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Spec PM(-3dB)" Foreground="{StaticResource SubTextBrush}" Margin="2,0,0,6"/>
                        <TextBox Text="{Binding PhaseMarginMinus3dBDeg, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <CheckBox Content="옵션: Plot을 이미지(PNG)로 따로 저장"
                          IsChecked="{Binding SavePlotImage}"
                          Margin="0,10,0,0"
                          Foreground="{StaticResource SubTextBrush}"/>

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                        Padding="10" Margin="0,12,0,0" Background="#FAFAFB">
                    <StackPanel>
                        <TextBlock Text="최근 처리 결과" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding LastGm, StringFormat=GM: {0} dB}" Grid.Row="0" Grid.Column="0"/>
                            <TextBlock Text="{Binding LastGmFreq, StringFormat=GM_Freq: {0} Hz}" Grid.Row="0" Grid.Column="1"/>

                            <TextBlock Text="{Binding LastPm, StringFormat=PM: {0} deg}" Grid.Row="1" Grid.Column="0" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding LastPmFreq, StringFormat=PM_Freq: {0} Hz}" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"/>

                            <TextBlock Text="{Binding Last10HzGain, StringFormat=10Hz Gain: {0} dB}" Grid.Row="2" Grid.Column="0" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding LastPm3, StringFormat=PM(-3dB): {0} deg}" Grid.Row="3" Grid.Column="0" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding LastPm3Freq, StringFormat=PM3_Freq: {0} Hz}" Grid.Row="3" Grid.Column="1" Margin="0,6,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding SourceFile}" Foreground="{StaticResource SubTextBrush}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>



        <DataTemplate DataType="{x:Type vm:DcSensitivitySpecViewModel}">
            <StackPanel>
                <TextBlock Text="DC Sensitivity" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="Data Type별 고정 헤더 규칙으로 컬럼을 찾고, 파일별 Up/Down plot을 생성합니다."
                           Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,10" TextWrapping="Wrap"/>

                <TextBlock Text="Data Type" Foreground="{StaticResource SubTextBrush}" Margin="2,0,0,6"/>
                <ComboBox ItemsSource="{Binding DataTypeOptions}" SelectedItem="{Binding SelectedDataType}"/>

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                        Padding="10" Margin="0,10,0,0" Background="#FAFAFB">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Rule" Foreground="{StaticResource SubTextBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConfiguredHeaderDescription}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Input" Foreground="{StaticResource SubTextBrush}" Margin="0,7,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConfiguredInputHeader}" Margin="0,7,0,0" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Output" Foreground="{StaticResource SubTextBrush}" Margin="0,7,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConfiguredOutputHeader}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <CheckBox Content="파일별 Up/Down plot PNG 저장" IsChecked="{Binding SavePlotImage}" Margin="0,10,0,0" Foreground="{StaticResource SubTextBrush}"/>
                <CheckBox Content="Summary Excel 저장 (한 시트에 plot 모으기)" IsChecked="{Binding SaveSummaryExcel}" Margin="0,6,0,0" Foreground="{StaticResource SubTextBrush}"/>

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                        Padding="10" Margin="0,12,0,0" Background="#FAFAFB">
                    <StackPanel>
                        <TextBlock Text="최근 처리 결과" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding LastSummary}" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ScanSpecViewModel}">
            <StackPanel>
                <TextBlock Text="SCAN" FontSize="13" FontWeight="SemiBold"/>

                <TextBlock Text="Data Type" Foreground="{StaticResource SubTextBrush}" Margin="2,10,0,6"/>
                <ComboBox ItemsSource="{Binding DataTypeOptions}" SelectedItem="{Binding SelectedDataType}"/>

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                        Padding="10" Margin="0,10,0,0" Background="#FAFAFB">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Rule" Foreground="{StaticResource SubTextBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConfiguredHeaderDescription}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Input" Foreground="{StaticResource SubTextBrush}" Margin="0,7,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConfiguredInputHeader}" Margin="0,7,0,0" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Output" Foreground="{StaticResource SubTextBrush}" Margin="0,7,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConfiguredOutputHeader}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <TextBlock Text="Range" Foreground="{StaticResource SubTextBrush}" Margin="2,10,0,6"/>
                <TextBox Text="{Binding RangesText, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         MinHeight="46"
                         Visibility="{Binding UsesAutomaticRange, Converter={StaticResource InvBoolToVis}}"/>
                <Border BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,8"
                        Background="#FAFAFB"
                        Visibility="{Binding UsesAutomaticRange, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding AutoRangeDescription}" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="Spec" Foreground="{StaticResource SubTextBrush}" Margin="2,10,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Spec HYS1 (abs max)" Foreground="{StaticResource SubTextBrush}" Margin="2,0,0,6"/>
                        <TextBox Text="{Binding SpecHys1, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Spec LI1 (abs max)" Foreground="{StaticResource SubTextBrush}" Margin="2,0,0,6"/>
                        <TextBox Text="{Binding SpecLi1, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <CheckBox Content="파일별 SCAN plot PNG 저장" IsChecked="{Binding SavePlotImage}" Margin="0,10,0,0" Foreground="{StaticResource SubTextBrush}"/>
                <CheckBox Content="Summary Excel 저장 (한 시트에 plot 모으기)" IsChecked="{Binding SaveSummaryExcel}" Margin="0,6,0,0" Foreground="{StaticResource SubTextBrush}"/>

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                        Padding="10" Margin="0,12,0,0" Background="#FAFAFB">
                    <StackPanel>
                        <TextBlock Text="최근 처리 결과" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LastRange1, StringFormat=Range: {0}}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,0,0" Text="{Binding LastHys1, StringFormat=HYS: {0}}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,0,0" Text="{Binding LastLi1, StringFormat=LI: {0}}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,6,0,0" Text="{Binding LastJudge, StringFormat=Judge: {0}}"/>
                        </Grid>
                        <TextBlock Text="{Binding LastReason, StringFormat=Reason: {0}}" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SourceFile}" Foreground="{StaticResource SubTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LastSummary}" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TiltSpecViewModel}">
            <StackPanel>
                <TextBlock Text="TILT" FontSize="13" FontWeight="SemiBold"/>

                <TextBlock Text="Data Type" Foreground="{StaticResource SubTextBrush}" Margin="2,10,0,6"/>
                <ComboBox ItemsSource="{Binding DataTypeOptions}" SelectedItem="{Binding SelectedDataType}"/>

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                        Padding="10" Margin="0,10,0,0" Background="#FAFAFB">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Rule" Foreground="{StaticResource SubTextBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConfiguredHeaderDescription}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Input" Foreground="{StaticResource SubTextBrush}" Margin="0,7,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConfiguredInputHeader}" Margin="0,7,0,0" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Output" Foreground="{StaticResource SubTextBrush}" Margin="0,7,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConfiguredOutputHeader}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <TextBlock Text="Spec Tilt (abs max)" Foreground="{StaticResource SubTextBrush}" Margin="2,10,0,6"/>
                <TextBox Text="{Binding SpecTilt, UpdateSourceTrigger=PropertyChanged}"/>

                <CheckBox Content="파일별 TILT plot PNG 저장" IsChecked="{Binding SavePlotImage}" Margin="0,10,0,0" Foreground="{StaticResource SubTextBrush}"/>
                <CheckBox Content="Summary Excel 저장 (한 시트에 plot 모으기)" IsChecked="{Binding SaveSummaryExcel}" Margin="0,6,0,0" Foreground="{StaticResource SubTextBrush}"/>

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
