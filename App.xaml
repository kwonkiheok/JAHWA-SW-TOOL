                        <TextBlock Text="Spec Max Settling(ms)" Foreground="{StaticResource SubTextBrush}" Margin="2,0,0,6"/>
                        <TextBox Text="{Binding MaxSettlingTimeMs, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

