<?xml version="1.0" encoding="utf-8"?>
<!--
  팀 배포용 게시 프로필 — 자체 포함(Self-contained) 단일 파일.

  · 결과물이 exe 파일 하나뿐이라 그것만 전달하면 된다.
  · 받는 PC에 .NET 8 Desktop Runtime 을 설치하지 않아도 실행된다(런타임이 exe 안에 포함).
  · DebugType=embedded 로 디버그 정보를 exe 안에 넣어 .pdb 파일이 따로 생기지 않게 한다
    (오류 발생 시 스택 추적에 줄 번호가 남는다).
  · PublishTrimmed 는 쓰지 않는다 — WPF 는 리플렉션을 많이 써서 트리밍 시 실행 중 깨질 수 있다.

  Visual Studio: 프로젝트 우클릭 → 게시 → 이 프로필 선택 → 게시
  명령줄       : dotnet publish -c Release -p:PublishProfile=SingleFile
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <!-- 프로젝트 폴더 기준 상대 경로: workspace\code\MeasureHub → workspace\배포\MeasureHub (PC가 바뀌어도 동작) -->
    <PublishDir>$(MSBuildProjectDirectory)\..\..\배포\MeasureHub\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
