<UserControl x:Class="JahwaInspector.Light.Views.PlotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Background="White"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="파일 목록" FontWeight="SemiBold"/>
                    <TextBlock Text="체크한 파일만 그래프 이미지로 저장합니다."
                               Foreground="{StaticResource SubTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <TextBox Grid.Row="2"
                         Text="{Binding PlotSearchText, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Grid.Row="4">
                    <!-- 검사항목 공통: 체크한 파일을 파일당 개별 PNG로 저장 -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="선택 파일 이미지 저장"
                                Style="{StaticResource GraphExtractButton}"
                                Command="{Binding SaveSelectedPlotImagesCommand}"
                                Margin="0,0,8,0"
                                Padding="18,7"
                                MinWidth="162"
                                FontWeight="Bold"/>

                        <TextBlock Text="{Binding SelectedPlotCount, StringFormat={}{0}개 선택}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SubTextBrush}"/>
                    </StackPanel>

                    <!-- FRA 전용: 체크한 파일을 한 장에 겹쳐 추출 -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,0"
                                Visibility="{Binding IsFraInspection, Converter={StaticResource BoolToVis}}">
                        <Button Content="선택 그래프 오버레이"
                                Style="{StaticResource GraphExtractButton}"
                                Command="{Binding SaveSelectedFraOverlayCommand}"
                                Margin="0,0,8,0"
                                Padding="18,7"
                                MinWidth="162"
                                FontWeight="Bold" Click="Button_Click"/>

                        <TextBlock Text="{Binding SelectedOverlayCount}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SubTextBrush}"/>
                    </StackPanel>

                    <!-- DC SENSITIVITY 전용: 체크한 파일을 한 장에 겹쳐 저장 -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,0"
                                Visibility="{Binding IsDcSensitivityInspection, Converter={StaticResource BoolToVis}}">
                        <Button Content="선택 파일 오버레이 저장"
                                Style="{StaticResource GraphExtractButton}"
                                Command="{Binding SaveSelectedDcOverlayCommand}"
                                Padding="18,7"
                                MinWidth="162"
                                FontWeight="Bold"/>
                    </StackPanel>

                    <!-- 오버레이 파일명에 붙일 라벨 (FRA / DC 공용) -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFraInspection}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDcSensitivityInspection}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="라벨"
                                   Foreground="{StaticResource SubTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBox Width="190"
                                 Text="{Binding SelectedOverlayExportLabel, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="6"
                         ItemsSource="{Binding PlotFilesFiltered}"
                         SelectedItem="{Binding SelectedPlotFile}"
                         Background="Transparent"
                         BorderThickness="0">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- 체크박스는 검사항목과 무관하게 항상 노출한다.
                                         (예전에는 FRA에서만 보여서 SETTLING의 '선택 파일 이미지 저장'을 쓸 수 없었다)
                                         단 ALL OVERLAY 가상 항목은 저장 대상이 아니므로 제외한다. -->
                                    <CheckBox IsChecked="{Binding IsOverlaySelected}"
                                              Margin="0,0,8,0"
                                              Visibility="{Binding IsAllOverlayItem, Converter={StaticResource InvBoolToVis}}"/>

                                    <TextBlock Text="{Binding FileName}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- PASS/NG 배지 + 색상 + 툴팁 -->
                                <Border Grid.Column="1"
                                        CornerRadius="10"
                                        Padding="8,2"
                                        Margin="10,0,0,0"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        ToolTip="{Binding JudgeReason}">

                                    <!-- 배경색 트리거 -->
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAllOverlayItem}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Judge}" Value="PASS">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Judge}" Value="NG">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <!-- 텍스트 색상 트리거 -->
                                    <TextBlock Text="{Binding Judge}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Black"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Judge}" Value="PASS">
                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Judge}" Value="NG">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Background="White"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PlotTitle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding FraHoverFrequencyLabel}"
                               Margin="12,0,0,0"
                               Foreground="{StaticResource SubTextBrush}"
                               Visibility="{Binding IsFraInspection, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="조건"
                               Margin="12,0,6,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SubTextBrush}"
                               Visibility="{Binding IsSettlingInspection, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox x:Name="SettlingGroupSelector"
                              Width="220"
                              VerticalAlignment="Center"
                              Visibility="{Binding IsSettlingInspection, Converter={StaticResource BoolToVis}}"
                              SelectionChanged="SettlingGroupSelector_SelectionChanged"/>
                </StackPanel>

                <!-- ScottPlot 컨트롤은 코드 비하인드에서 생성해 XAML 파싱 이슈를 피합니다. -->
                <Border Grid.Row="2"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Background="White">
                    <Grid x:Name="PlotHost"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

